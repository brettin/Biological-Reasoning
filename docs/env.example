# BioR5 Configuration Template - Scenario 2: Mixed Cloud + Local Setup
# Copy this file to .env in your project root and update with your actual values

# ==========================================
# PRIMARY LLM CONFIGURATION (Required)
# ==========================================
# Used for main biological reasoning and coordination
# Recommended: Use reliable cloud provider (OpenAI, Anthropic, etc.)

BIO_PRIMARY_API_KEY=sk-your-openai-api-key-here
BIO_PRIMARY_BASE_URL=https://api.openai.com/v1
BIO_PRIMARY_MODEL_NAME=gpt-4o
BIO_PRIMARY_TEMPERATURE=0.7
BIO_PRIMARY_MAX_TOKENS=4096
BIO_PRIMARY_TIMEOUT=30
BIO_PRIMARY_STREAM=true

# ==========================================
# TX-GEMMA CONFIGURATION (Optional)
# ==========================================
# Used for specialized toxicity predictions
# Recommended: Local deployment for cost efficiency and performance
# If not configured, toxicity predictions will fall back to primary LLM

BIO_TXGEMMA_API_KEY=EMPTY
BIO_TXGEMMA_BASE_URL=http://localhost:8000/v1
BIO_TXGEMMA_MODEL_NAME=google/txgemma-27b-chat
BIO_TXGEMMA_TEMPERATURE=0.1
BIO_TXGEMMA_MAX_TOKENS=2048
BIO_TXGEMMA_TIMEOUT=60
BIO_TXGEMMA_STREAM=false

# ==========================================
# REGISTRY/TRIAGE CONFIGURATION (Optional)
# ==========================================
# Used for intelligent reasoning mode selection
# Falls back to primary LLM if not specified
# Recommended: Use faster/cheaper model for quick routing decisions

BIO_REGISTRY_API_KEY=sk-your-openai-api-key-here
BIO_REGISTRY_BASE_URL=https://api.openai.com/v1
BIO_REGISTRY_MODEL_NAME=gpt-4-turbo
BIO_REGISTRY_TEMPERATURE=0.1
BIO_REGISTRY_MAX_TOKENS=800
BIO_REGISTRY_TIMEOUT=30
BIO_REGISTRY_STREAM=false








